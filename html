 document.getElementById('filmGrid').innerHTML=list.length?list.map(f=>`<article class="card"><div class="film-swatch" style="background:linear-gradient(110deg,${f.colors.join(',')})"></div><span class="mono">${f.brand.toUpperCase()} / ${f.type.toUpperCase()}</span><h3>${f.name}</h3><p>${f.desc}</p><span class="pill">${f.iso}</span><span class="pill">${f.format}</span><span class="pill">${f.process}</span><a class="text-link" target="_blank" rel="noopener" href="https://www.google.com/search?q=${encodeURIComponent(f.name+' film mua Việt Nam')}">Tìm nơi bán ↗</a></article>`).join(''):'<div class="empty">Không tìm thấy cuộn film phù hợp.</div>';
}

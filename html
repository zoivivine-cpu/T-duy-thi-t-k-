 document.getElementById('labGrid').innerHTML=list.length?list.map(l=>`<article class="card"><div class="lab-card"><div class="lab-icon">${l.emoji}</div><div><span class="mono">${l.region.toUpperCase()}</span><h3>${l.name}</h3><p>${l.desc}</p><a class="text-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/${encodeURIComponent('film lab tráng scan film '+l.city)}">Mở bản đồ ↗</a></div></div></article>`).join(''):'<div class="empty">Không tìm thấy khu vực phù hợp.</div>';

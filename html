function marketplace(name){return 'https://www.google.com/search?q='+encodeURIComponent(name+' máy ảnh film mua bán Việt Nam')}
function renderCameras(list){
 const grid=document.getElementById('cameraGrid');
 grid.innerHTML=list.length?list.map(c=>`<article class="item-card"><div class="item-visual">${c.emoji}</div><div class="item-info"><span class="mono">${c.brand.toUpperCase()} / ${c.type.toUpperCase()}</span><h3>${c.name}</h3><p>${c.desc}</p><p><b>${c.price}</b></p><a class="text-link" target="_blank" rel="noopener" href="${marketplace(c.name)}">Tìm nơi bán ↗</a></div></article>`).join(''):'<div class="empty">Không tìm thấy mẫu máy phù hợp.</div>';
}
function filterCameras(){
 const q=document.getElementById('cameraSearch').value.toLowerCase(),t=document.getElementById('cameraType').value,b=document.getElementById('cameraBrand').value;
 renderCameras(cameras.filter(c=>(c.name+' '+c.brand).toLowerCase().includes(q)&&(t==='all'||c.type===t)&&(b==='all'||c.brand===b)));
}
